{
  "name": "@pinme/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "shadow-db:bootstrap": "node shadow-db/manage.mjs bootstrap",
    "shadow-db:start": "node shadow-db/manage.mjs start",
    "shadow-db:stop": "node shadow-db/manage.mjs stop",
    "photos:backfill-thumbnails": "ts-node src/scripts/backfillPhotoThumbnails.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1070.0",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.15.5",
    "multer": "^2.1.1",
    "sharp": "^0.35.1",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "embedded-postgres": "^16.14.0-beta.17",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
