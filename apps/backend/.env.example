# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL via Supabase)
# Runtime app queries use the transaction-mode pooler.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DATABASE_PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma migrations use the session-mode pooler.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DATABASE_PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# Supabase
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# JWT (for custom token verification)
JWT_SECRET="your-jwt-secret-min-32-chars"

# AI reply assistant (Groq)
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="llama-3.3-70b-versatile"

# LiveKit (voice calls)
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

# APNs VoIP Push (private 1:1 voice calling — phase 3, see
# docs/private-voice-calling-spec.md "iOS 原生能力").
# The `.p8` Apple APNs Auth Key must be injected via the deployment
# environment's secret store — never commit the `.p8` file or its decoded
# contents to this repo.
# APNS_PRIVATE_KEY_BASE64 is the Base64 encoding of the *entire* `.p8` PEM
# file contents (including the "-----BEGIN PRIVATE KEY-----" header/footer).
# Sandbox vs. production APNs endpoint is chosen per-request from that
# device's own VoipDeviceToken.environment — this is not a single global
# switch.
# APNS_BUNDLE_ID and APNS_VOIP_TOPIC must exactly match the real Apple
# Developer App ID and its associated VoIP Services topic
# (`<bundleId>.voip`); the sender refuses to send if they don't match.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_BASE64=
APNS_BUNDLE_ID=com.micimici.pinme
APNS_VOIP_TOPIC=com.micimici.pinme.voip

# Testing (apps/backend/tests/*.test.ts, e.g. tests/calls.test.ts)
# DB-backed test suites refuse to run unless this is set — they will NOT
# fall back to DATABASE_URL, to avoid ever touching a shared dev database.
# Point this at an isolated Postgres database, e.g. one of:
#   - A local Postgres via Docker: `docker run -p 5433:5432 -e POSTGRES_PASSWORD=test postgres:16`
#     then TEST_DATABASE_URL="postgresql://postgres:test@localhost:5433/pinme_test"
#   - A separate schema on the same Supabase project:
#     TEST_DATABASE_URL="postgresql://...supabase.../postgres?schema=test"
# Run `npx prisma migrate deploy` against TEST_DATABASE_URL once before
# running tests so the isolated database has the current schema.
TEST_DATABASE_URL=
