generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                 @id @default(uuid())
  email                   String?                @unique
  phone                   String?                @unique
  name                    String
  gender                  Gender
  birthday                DateTime               @db.Date
  bio                     String?
  city                    String?
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")
  supabaseAuthId          String                 @unique
  blocksReceived          Block[]                @relation("BlockedBlocks")
  blocksGiven             Block[]                @relation("BlockerBlocks")
  location                Location?
  matchesAsUser1          Match[]                @relation("User1Matches")
  matchesAsUser2          Match[]                @relation("User2Matches")
  messagesSent            Message[]
  messageReactions        MessageReaction[]
  photos                  Photo[]
  preferences             Preference?
  privacySettings         PrivacySettings?
  profile                 Profile?
  reportsReceived         Report[]               @relation("ReportedReports")
  reportsGiven            Report[]               @relation("ReporterReports")
  swipesGiven             Swipe[]                @relation("SwiperSwipes")
  swipesReceived          Swipe[]                @relation("TargetSwipes")
  ownedVoiceRooms         VoiceRoom[]            @relation("VoiceRoomOwner")
  voiceRoomParticipations VoiceRoomParticipant[]
  subscription            Subscription?
  pushTokens              PushToken[]
  callPreferences         CallPreference[]
  callsAsCaller           Call[]                 @relation("CallCaller")
  callsAsCallee           Call[]                 @relation("CallCallee")
  voipDeviceTokens        VoipDeviceToken[]

  @@map("users")
}

model Profile {
  id                       String            @id @default(uuid())
  userId                   String            @unique @map("user_id")
  height                   Int?
  pronouns                 String?
  sexualOrientation        String?           @map("sexual_orientation")
  sexualOrientationVisible Boolean           @default(false) @map("sexual_orientation_visible")
  education                String?
  educationLevel           String?           @map("education_level")
  jobTitle                 String?           @map("job_title")
  company                  String?
  companyVisible           Boolean           @default(false) @map("company_visible")
  languages                String[]          @default([])
  hometown                 String?
  relationshipGoal         RelationshipGoal? @map("relationship_goal")
  drinking                 String?
  smoking                  String?
  exercise                 String?
  dietary                  String?
  drugs                    String?
  pets                     String?
  sleepHabit               String?           @map("sleep_habit")
  socialHabit              String?           @map("social_habit")
  children                 String?
  wantsChildren            String?           @map("wants_children")
  relationshipStyle        String?           @map("relationship_style")
  communicationStyle       String?           @map("communication_style")
  idealFirstDate           String?           @map("ideal_first_date")
  interests                String[]          @default([])
  weekend                  String?
  favorites                String?
  mbti                     String?
  constellation            String?
  prompt1Question          String?           @map("prompt_1_question")
  prompt1                  String?           @map("prompt_1")
  prompt2Question          String?           @map("prompt_2_question")
  prompt2                  String?           @map("prompt_2")
  prompt3Question          String?           @map("prompt_3_question")
  prompt3                  String?           @map("prompt_3")
  hiddenFields             String[]          @default([]) @map("hidden_fields")
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Photo {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  url          String
  thumbnailUrl String?   @map("thumbnail_url")
  orderIndex   Int       @default(0) @map("order_index")
  isPrimary    Boolean   @default(false) @map("is_primary")
  isVerified   Boolean   @default(false) @map("is_verified")
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isPrimary, orderIndex, createdAt])
  @@map("photos")
}

model Preference {
  id              String  @id @default(uuid())
  userId          String  @unique @map("user_id")
  preferredGender Gender? @map("preferred_gender")
  minAge          Int?    @map("min_age")
  maxAge          Int?    @map("max_age")
  maxDistanceKm   Int?    @map("max_distance_km")
  minHeight       Int?    @map("min_height")
  maxHeight       Int?    @map("max_height")
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("preferences")
}

model Location {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  latitude  Float
  longitude Float
  city      String?
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("locations")
}

model Swipe {
  id        String      @id @default(uuid())
  swiperId  String      @map("swiper_id")
  targetId  String      @map("target_id")
  action    SwipeAction
  createdAt DateTime    @default(now()) @map("created_at")
  swiper    User        @relation("SwiperSwipes", fields: [swiperId], references: [id], onDelete: Cascade)
  target    User        @relation("TargetSwipes", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([swiperId, targetId])
  @@index([targetId])
  @@index([targetId, action, createdAt])
  @@map("swipes")
}

model Match {
  id              String           @id @default(uuid())
  user1Id         String           @map("user1_id")
  user2Id         String           @map("user2_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  unmatchedAt     DateTime?        @map("unmatched_at")
  user1           User             @relation("User1Matches", fields: [user1Id], references: [id], onDelete: Cascade)
  user2           User             @relation("User2Matches", fields: [user2Id], references: [id], onDelete: Cascade)
  messages        Message[]
  callPreferences CallPreference[]
  calls           Call[]

  @@unique([user1Id, user2Id])
  @@index([user1Id, unmatchedAt, createdAt])
  @@index([user2Id, user1Id])
  @@index([user2Id, unmatchedAt, createdAt])
  @@map("matches")
}

model Message {
  id          String            @id @default(uuid())
  matchId     String            @map("match_id")
  senderId    String?           @map("sender_id")
  content     String
  messageType MessageType       @default(TEXT) @map("message_type")
  durationSec Int?              @map("duration_sec")
  replyToId   String?           @map("reply_to_id")
  isRead      Boolean           @default(false) @map("is_read")
  recalledAt  DateTime?         @map("recalled_at")
  callId      String?           @unique @map("call_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  match       Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender      User?             @relation(fields: [senderId], references: [id], onDelete: SetNull)
  replyTo     Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]         @relation("MessageReplies")
  reactions   MessageReaction[]
  call        Call?             @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([matchId, createdAt])
  @@index([matchId, isRead, senderId])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_reactions")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")
  blocked   User     @relation("BlockedBlocks", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("BlockerBlocks", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId, blockerId])
  @@map("blocks")
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String       @map("reporter_id")
  reportedId  String       @map("reported_id")
  reason      String
  description String?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")
  reported    User         @relation("ReportedReports", fields: [reportedId], references: [id], onDelete: Cascade)
  reporter    User         @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model PrivacySettings {
  id               String  @id @default(uuid())
  userId           String  @unique @map("user_id")
  discoverable     Boolean @default(true)
  showDistance     Boolean @default(false) @map("show_distance")
  showOnlineStatus Boolean @default(false) @map("show_online_status")
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

model VoiceRoom {
  id              String                 @id @default(uuid())
  ownerId         String                 @map("owner_id")
  name            String
  tags            String[]               @default([])
  livekitRoomName String                 @unique @map("livekit_room_name")
  isOpen          Boolean                @default(true) @map("is_open")
  createdAt       DateTime               @default(now()) @map("created_at")
  closedAt        DateTime?              @map("closed_at")
  owner           User                   @relation("VoiceRoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  participants    VoiceRoomParticipant[]

  @@index([ownerId])
  @@index([isOpen, createdAt])
  @@map("voice_rooms")
}

model VoiceRoomParticipant {
  id            String    @id @default(uuid())
  roomId        String    @map("room_id")
  userId        String    @map("user_id")
  isMutedByHost Boolean   @default(false) @map("is_muted_by_host")
  joinedAt      DateTime  @default(now()) @map("joined_at")
  leftAt        DateTime? @map("left_at")
  room          VoiceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@map("voice_room_participants")
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String             @unique @map("user_id")
  status    SubscriptionStatus @default(ACTIVE)
  plan      String             @default("premium")
  source    String             @default("promo")
  promoCode String?            @map("promo_code")
  expiresAt DateTime?          @map("expires_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("push_tokens")
}

// Per-match, per-user opt-in for private 1:1 voice calling. A call can only
// be started once both participants' audioEnabled flags are true. See
// docs/private-voice-calling-spec.md for the full state machine.
model CallPreference {
  id            String    @id @default(uuid())
  matchId       String    @map("match_id")
  userId        String    @map("user_id")
  audioEnabled  Boolean   @default(false) @map("audio_enabled")
  videoEnabled  Boolean   @default(false) @map("video_enabled")
  lastInvitedAt DateTime? @map("last_invited_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  match         Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId])
  @@map("call_preferences")
}

// The Call row is the single source of truth for the call state machine.
// A partial unique index on (match_id) WHERE status IN ('RINGING','ACCEPTED')
// is added by hand in the migration SQL (Prisma's schema DSL has no partial
// index syntax) to guarantee at most one active call per match at the DB
// level; the cross-match "one active call per user" invariant is enforced
// in application code via a serializable transaction (see src/lib/calls.ts).
model Call {
  id            String     @id @default(uuid())
  matchId       String     @map("match_id")
  callerId      String     @map("caller_id")
  calleeId      String     @map("callee_id")
  type          CallType   @default(AUDIO)
  status        CallStatus @default(RINGING)
  roomName      String     @unique @map("room_name")
  expiresAt     DateTime   @map("expires_at")
  answeredAt    DateTime?  @map("answered_at")
  endedAt       DateTime?  @map("ended_at")
  endedById     String?    @map("ended_by_id")
  durationSec   Int?       @map("duration_sec")
  failureReason String?    @map("failure_reason")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  match         Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  caller        User       @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee        User       @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  systemMessage Message?

  @@index([matchId, createdAt])
  @@index([callerId, status])
  @@index([calleeId, status])
  @@index([status, expiresAt])
  @@map("calls")
}

model VoipDeviceToken {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  token       String          @unique
  platform    DevicePlatform
  environment ApnsEnvironment
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("voip_device_tokens")
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACCEPTED
  DECLINED
  CANCELED
  MISSED
  ENDED
  FAILED
}

enum DevicePlatform {
  IOS
  ANDROID
}

enum ApnsEnvironment {
  SANDBOX
  PRODUCTION
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  SELF_DESCRIBE
  PREFER_NOT_TO_SAY
  OTHER
}

enum RelationshipGoal {
  LONG_TERM
  SERIOUS_OPEN_TO_SHORT_TERM
  CASUAL
  SERIOUS
  FRIENDSHIP
  UNDECIDED
}

enum SwipeAction {
  LIKE
  DISLIKE
  SUPER_LIKE
}

enum MessageType {
  TEXT
  IMAGE
  GIF
  SYSTEM
  VOICE
  VIDEO
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}
