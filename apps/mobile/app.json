{
  "expo": {
    "name": "PinMe",
    "slug": "pinme-dating-app",
    "owner": "micimici",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pinme.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PinMe needs your location to show nearby people.",
        "NSPhotoLibraryUsageDescription": "PinMe needs access to your photos to update your profile.",
        "NSCameraUsageDescription": "PinMe needs camera access to take profile photos.",
        "NSMicrophoneUsageDescription": "PinMe needs microphone access for voice calls.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pinme.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow PinMe to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PinMe to access your photos.",
          "cameraPermission": "Allow PinMe to take photos."
        }
      ],
      "expo-notifications",
      "expo-font"
    ],
    "scheme": "pinme",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "19ef99e0-6eca-496c-9f89-904e55c06d13"
      }
    }
  }
}
